# ── Supabase (metadata only — never keys) ──────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Server-only (optional, for admin/meter webhooks later)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Stripe ─────────────────────────────────────────────────────────
# Use sk_test_... for staging, sk_live_... for production
STRIPE_SECRET_KEY=sk_test_...
# Optional webhook (Dashboard → Developers → Webhooks)
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs from Stripe Dashboard → Products (preferred in prod)
# Create:
#   GateZero Pro        $29/mo  recurring → copy price_...
#   GateZero Enterprise $299/mo recurring → copy price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_ENTERPRISE=price_...

# Meter event name must match Stripe Billing Meter (event_name)
# Dashboard → Billing → Meters → create "api_proxy_usage" (sum)

# ── Site ───────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://gatezero.app

# ── GateZero 2.0 engine ────────────────────────────────────────────
# 32-byte hex (64 chars) wrapping key for provider credentials at rest
GATEZERO_VAULT_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Stripe webhook endpoint: https://YOUR_DOMAIN/api/webhooks/stripe
# Events: checkout.session.completed, invoice.paid, invoice.payment_succeeded
